# pracovní soubory a stažené stránky (nejdou na web ani do historie)
pracovni/
# celé svazky stažené z archivů (složky CZ_… v dokumenty/) – stovky MB, zůstávají jen na disku, do gitu jdou výřezy
dokumenty/CZ_*/
# vytvořené výstupy (vějíř k tisku, rodokmen v jednom souboru – velké, dají se kdykoli vytvořit znovu)
vystupy/
# mapa domů ze skillu stare-adresy (mapa.py data/domy …) – do gitu jde adresy.json, domy.geojson a vyrezy/
data/domy/podklady/
data/domy/cache/
data/domy/index.html
data/domy/files.json
data/domy/chybi.txt
__pycache__/
.DS_Store
Thumbs.db
desktop.ini
*.tar.gz
# web – závislosti, build a vše, co generuje `npm run data`
web/node_modules/
web/dist/
web/.astro/
web/.netlify/
web/src/data/site.json
web/src/generated/
web/public/img/
web/public/zdroje/
web/public/prihlaseni.html
web/nginx.conf
web/netlify/edge-functions/
