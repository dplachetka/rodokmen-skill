---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import SideCard from '../../components/SideCard.astro';
import { people, families, lineByK, records, href, sideGroups, sideTitle } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(families).map((id) => ({ params: { id } }));
}
const f = families[Astro.params.id];
const father = f.father ? people[f.father] : null;
const mother = f.mother ? people[f.mother] : null;
const children = f.children.map((s) => people[s]);
const line = f.line ? lineByK[f.line] : null;
const title = [father?.name ?? (f.fatherUnknown ? 'otec neuveden' : 'neznámý otec'), mother?.name ?? 'neznámá matka'].join(' a ');
const groups = sideGroups(f.side);
// všechny děti rodiny v pořadí narození: přímý předek (zvýrazněný) i sourozenci; bez známého narození na konec
const sibs = groups.find(([g]) => g === 'sib')?.[1] ?? [];
const kids = [...children.map((p) => ({ p, born: p.born ?? '' })), ...sibs.map((s) => ({ s, born: s.born ?? '' }))]
  .sort((a, b) => Number(a.born === '') - Number(b.born === '') || a.born.localeCompare(b.born));
---
<Base title={`Rodina: ${title}`}>
  <p class="crumbs">Rodina{line && <> · <a href={href.line(line.slug)}>rod {line.name}</a></>}</p>
  <h1>{title}</h1>

  <div class="grid2">
    {[father, mother].map((p, i) => (
      <div class="card">
        <h3>{i === 0 ? 'Otec' : 'Matka'}</h3>
        {p ? (
          <>
            <p><PersonLink slug={p.slug} /><br /><span class="small muted">{p.rel}</span></p>
            {p.facts.length > 0 && <ul class="facts small">{p.facts.map((x) => <li>{x}</li>)}</ul>}
            {p.family && <p class="small"><a href={href.family(p.family)}>Rodina, ze které pochází →</a></p>}
          </>
        ) : <p class="muted">{i === 0 && f.fatherUnknown ? 'V zápisech neuveden – dítě se narodilo jako nemanželské.' : 'Zatím neznámá osoba.'}</p>}
      </div>
    ))}
  </div>

  {f.marriage.length > 0 && (
    <>
      <h2>Sňatek</h2>
      <ul class="facts">{f.marriage.map((m) => <li>{m.replace(/^×\s*/, '')}</li>)}</ul>
    </>
  )}

  <h2>Děti</h2>
  <div class="grid2">
    {kids.map((x) => x.p ? (
      <div class="card direct">
        <h3><PersonLink slug={x.p.slug} /></h3>
        <div class="chips"><span class="chip">přímý předek – {x.p.rel}</span></div>
        {x.p.facts.some((t) => /^[*†]/.test(t.trim())) && <ul class="facts small">{x.p.facts.filter((t) => /^[*†]/.test(t.trim())).map((t) => <li>{t}</li>)}</ul>}
      </div>
    ) : <SideCard s={x.s} />)}
  </div>
  <p class="small muted">{{
    done: 'Sourozence jsme dohledali všechny.',
    partial: 'Sourozence jsme hledali jen částečně – tady jsou ti, které jsme zatím našli.',
  }[people[f.child]?.sibStatus] ?? 'Další sourozence zatím systematicky nehledáme – tady jsou jen ti, na které jsme narazili.'}</p>
  {groups.filter(([g]) => g !== 'sib').map(([g, list]) => (
    <>
      <h2>{sideTitle[g]}</h2>
      <div class="grid2">{list.map((s) => <SideCard s={s} />)}</div>
    </>
  ))}

  {f.records.length > 0 && (
    <>
      <h2>Zápisy</h2>
      <div class="recs">{f.records.filter((r) => records[r]).map((r) => <Record id={r} />)}</div>
    </>
  )}
</Base>
