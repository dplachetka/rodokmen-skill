---
// Interactive ancestor tree: parents above the child, each branch collapsible, relatives from SIDE beside the ancestor.
// Rooted at Kekulé number from the hash (#k=4) so a person page can open the tree from that person.
import Base from '../layouts/Base.astro';
import { byK, lineByK, records, href } from '../lib/data.js';
const nodes = Object.fromEntries(Object.entries(byK).map(([k, p]) => {
  const alias = p.k !== Number(k);
  return [k, {
    s: href.person(p.slug), n: p.name, y: p.years, c: p.line ? lineByK[p.line]?.color : null, a: alias ? 1 : 0,
    fu: p.fatherUnknown ? 1 : 0, b: p.sibStatus ?? 'none',
    sd: alias ? [] : p.side.map((e) => ({ n: e.name, r: e.rel || 'vztah neuveden', y: e.years ?? '', kind: e.kind ?? 'other', t: e.text, f: e.facts ?? [], st: e.status ?? '',
      z: e.records.filter((r) => records[r]).map((r) => [href.record(r), records[r].date]) })),
  }];
}));
const json = JSON.stringify(nodes).replace(/</g, '\\u003c');
---
<Base title="Stromový graf" full>
  <div class="fan-bar">
    <strong>Stromový graf</strong>
    <span class="fan-btns">
      <button type="button" data-act="open">Rozbalit vše</button>
      <button type="button" data-act="close">Sbalit vše</button>
      <button type="button" data-act="fit">Celý</button>
      <button type="button" data-act="root" hidden>Od začátku</button>
    </span>
    <span class="small muted fan-hint">Tlačítkem nad osobou rozbalíte/sbalíte její předky, pod jménem její sourozence. Kolečkem přibližujte, tažením posouvejte.</span>
  </div>
  <div class="tree-stage">
    <div class="tree-canvas"><svg class="tree-lines"></svg></div>
    <div class="tree-info" hidden></div>
  </div>
  <script type="application/json" id="tree-data" set:html={json} />

  <script>
    // logika stromu je společná s tools/jeden_soubor.py (lib/strom.js)
    import { stromovyGraf } from '../lib/strom.js';
    stromovyGraf({
      N: JSON.parse(document.getElementById('tree-data')!.textContent!),
      stage: document.querySelector('.tree-stage')!,
      buttons: document.querySelector('.fan-btns')!,
    });
  </script>
</Base>
